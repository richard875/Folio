[Unit]
Description=Check Folio availability and persistent storage
After=folio.service

[Service]
Type=oneshot
User=folio
Group=folio
EnvironmentFile=/etc/folio/folio.env
ExecStart=/usr/bin/node /opt/folio/scripts/healthcheck-production.mjs
TimeoutStartSec=15
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
