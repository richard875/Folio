{
    servers {
        protocols h1 h2
        timeouts {
            read_header 10s
            read_body 30s
            write 75m
            idle 2m
        }
    }
    # Error logs can contain full request URIs; discard request-scoped logs too.
    log default {
        exclude http.log.access http.log.error
    }
    grace_period 90s
}

# Replace folio.example.com with your real hostname and point its DNS at the VM.
folio.example.com {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        X-Frame-Options "DENY"
        -Server
    }
    request_body {
        max_size 64KB
    }
    # No access-log directive: query hashes must not enter request logs.
    # Never expose the app directory, output/, environment file, or port 3000.
    reverse_proxy 127.0.0.1:3000 {
        transport http {
            dial_timeout 5s
            response_header_timeout 70m
        }
        # No retries: saves/collection may continue after a client disconnects.
        lb_try_duration 0
    }
}
