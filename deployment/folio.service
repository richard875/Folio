[Unit]
Description=Folio API and website
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=folio
Group=folio
WorkingDirectory=/opt/folio
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
Environment=NITRO_SHUTDOWN_TIMEOUT=60000
EnvironmentFile=/etc/folio/folio.env
ExecStart=/usr/bin/flock --nonblock --no-fork /opt/folio/output/.server.lock /usr/bin/node --max-old-space-size=2048 /opt/folio/scripts/start-production.mjs
Restart=on-failure
RestartSec=5
UMask=0077
TimeoutStartSec=120
TimeoutStopSec=90
KillMode=mixed
OOMPolicy=stop
MemoryAccounting=true
MemoryHigh=3G
MemoryMax=4G
TasksMax=128
LimitNOFILE=16384
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/folio/output
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
