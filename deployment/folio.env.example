# Install as /etc/folio/folio.env, owned root:folio, mode 0640.
# Generate ACCESS_HASH with: openssl rand -hex 32
# Replace this placeholder; never commit or share the real value.
ACCESS_HASH=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
READ_CONCURRENCY=5
SAVE_CONCURRENCY=5
RSS_LINKS_PER_SECTION=5
FETCH_RETRY_LIMIT=5
HOST=127.0.0.1
PORT=3000
# Keep DATABASE_URL and NODE_OPTIONS unset. Folio uses file storage.
