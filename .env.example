# Required server-only shared key: generate with openssl rand -hex 32; never share URLs containing it.
ACCESS_HASH=
# Runtime bind address; Render requires all interfaces.
HOST=0.0.0.0
# Render supplies PORT automatically; 3000 is the local fallback.
PORT=3000
# Runtime mode; never set database credentials for this temporary-storage deployment.
NODE_ENV=production
# V8 heap only, not total resident memory; build-time commands use a scoped 4096 MB override.
NODE_OPTIONS=--max-old-space-size=256 --max-semi-space-size=16
# Number of simultaneous article extractions; keep at 1 on Render Free.
READ_CONCURRENCY=1
# Number of concurrent saves in a background collection; keep at 1.
SAVE_CONCURRENCY=1
# Concurrent feed downloads/resolutions; all 12 sources remain configured.
FEED_CONCURRENCY=2
# Eligible links per configured publisher section.
RSS_LINKS_PER_SECTION=5
# Fetch retries after the initial attempt; zero disables retries.
FETCH_RETRY_LIMIT=2
# Keep unused account-auth scaffolding disabled; ACCESS_HASH still protects Folio APIs.
VITE_AUTH_ENABLED=false
# Drain timeout in milliseconds; Render Blueprint allows 60 seconds before SIGKILL.
NITRO_SHUTDOWN_TIMEOUT=45000

# Optional platform metadata, not required on Render; VITE_ values are public.
# VITE_PUBLIC_HOSTNAME=       # Public app hostname for metadata.
# VITE_PROJECT_ID=            # Optional platform project identity.
# VITE_GROK_EXTENSIONS=       # Platform extension metadata toggle; branding remains intact.
# VITE_OG_SERVICE_URL=        # Optional share-card service origin.
# X_CREATOR=                 # Optional public creator handle.
# X_CREATOR_ID=              # Optional public creator ID.

# Unused scaffolding: leave unset; these are NOT Render deployment requirements.
# DATABASE_URL=              # External Postgres connection secret; this deployment rejects it.
# BETTER_AUTH_SECRET=        # Optional account-auth signing secret, unused.
# BETTER_AUTH_URL=           # Optional account-auth public origin, unused.
# GROK_AUTH_ISSUER=          # Optional auth broker origin, unused.
# GROK_AUTH_CLIENT_ID=       # Optional auth client identity, unused.
# GROK_AUTH_CLIENT_SECRET=   # Optional auth client secret, unused.
# GROK_GATE_ORIGIN=          # Optional gate identity issuer, unused.
# GROK_PROJECT_ID=           # Optional deployed gate project identity, unused.
# GROK_CONNECTORS_URL=       # Optional connector gateway origin, unused.
# GROK_CONNECTOR_ACCESS_TOKEN= # Optional server-only connector secret, unused.
# VITE_STUN_URLS=            # Optional WebRTC configuration, unused.
# NITRO_HOST=               # Compatibility value overwritten from HOST at startup.
# NITRO_PORT=               # Compatibility value overwritten from PORT at startup.
# NITRO_UNIX_SOCKET=        # Unsupported in this deployment.
# NITRO_SSL_CERT=           # Unsupported; Render terminates TLS.
# NITRO_SSL_KEY=            # Unsupported; Render terminates TLS.

# Local QA only; not needed in the Render dashboard.
# BROWSER_ALLOW_EXTERNAL_HOST= # Opt-in external targets for browser QA.
# BROWSER_SMOKE_TIMEOUT_MS=     # Browser navigation timeout.
# PREVIEW_THUMBNAIL_TIMEOUT_MS= # Thumbnail timeout.
# PREVIEW_READY_TIMEOUT_MS=     # Built-preview startup timeout.
# PRODUCTION_SMOKE_PORT=        # Disposable test server port, default 8081.
# PRODUCTION_SMOKE_COMPARE_DEV= # Set 1 to compare an already-running dev server.
